[Unit]
Description=Local voice input daemon
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/dev/Personal/voice
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/dev/Personal/voice/.venv/bin/voice-input --config %h/.config/voice-input/config.toml daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
