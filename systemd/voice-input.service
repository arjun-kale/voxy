# Headless alternative to the desktop app (which starts itself at login).
# Install with: cp systemd/voice-input.service ~/.config/systemd/user/ &&
#   systemctl --user enable --now voice-input.service
[Unit]
Description=Voxy voice typing (headless)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voxy daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
